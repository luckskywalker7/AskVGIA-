# ── Application ──────────────────────────────────────────────────────
APP_NAME=Agentic Video Search
ENVIRONMENT=development
DEBUG=true

# ── WhisperX ─────────────────────────────────────────────────────────
WHISPER_MODEL=medium
# Use "cpu" if this machine has no NVIDIA GPU.
WHISPER_DEVICE=cuda
# Use "int8" (or "float32" on CPU) if this machine has no NVIDIA GPU.
WHISPER_COMPUTE_TYPE=float16

# ── Pyannote diarization ──────────────────────────────────────────────
# Very slow on CPU (32 min for a 55s video) — disable for development
# on machines without a GPU.
PYANNOTE_ENABLED=true
# Required: HuggingFace token with access to pyannote/speaker-diarization.
# Get one at https://huggingface.co/settings/tokens
HF_TOKEN=changeme

# ── Storage / FAISS ───────────────────────────────────────────────────
STORAGE_DIR=data/faiss_store
FAISS_INDEX_TYPE=hnsw
FAISS_HNSW_EF_SEARCH=256

# ── Query cache ───────────────────────────────────────────────────────
QUERY_CACHE_SIMILARITY=0.95

# ── Vision / OCR ──────────────────────────────────────────────────────
VISION_ENABLED=true
VISION_FRAME_INTERVAL_SECONDS=5.0
VISION_FRAME_INTERVAL_S=5.0
VISION_MAX_FRAMES=800
VISION_SCENE_THRESHOLD=0.25
VISION_DEDUP_PHASH_DISTANCE=18
VISION_STRUCTURAL_SIM_THRESHOLD=0.97

OCR_ENABLED=true
OCR_BACKEND=easyocr
OCR_LANGUAGES=["en","fr","ar"]

# ── VLM (frame captioning — runs at INDEX time) ───────────────────────
VISION_MODEL_ENABLED=true
VLM_BACKEND=ollama
VLM_OLLAMA_URL=http://localhost:11434
VLM_PRIMARY_MODEL=qwen2.5vl:7b
VLM_FALLBACK_MODELS=["qwen2.5vl:7b"]
VLM_MAX_RETRIES=2
VLM_TIMEOUT_S=120.0
VLM_MAX_CONCURRENCY=1
VLM_DEVICE=auto

# ── CLIP ──────────────────────────────────────────────────────────────
VLM_CLIP_ENABLED=true
VLM_CLIP_DEVICE=cpu

# ── Embeddings ────────────────────────────────────────────────────────
NOMIC_ENABLED=false
COLBERT_ENABLED=true
HYDE_ENABLED=true
EMBEDDING_CACHE_ENABLED=true
EMBEDDING_CACHE_TTL_SECONDS=2592000.0

# ── Ollama ────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen3:8b
OLLAMA_VISION_MODEL=qwen2.5vl:7b

# ── Answering quality ─────────────────────────────────────────────────
ANSWER_MAX_EVIDENCE=6
ANSWER_MAX_CONTEXT_CHUNKS=10

# ── BGE-M3 embedding device ───────────────────────────────────────────
BGE_DEVICE=cpu
